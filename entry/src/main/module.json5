{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone", "tablet"
    ],
    "requestPermissions": [
      { "name": "ohos.permission.PUBLISH_AGENT_REMINDER" },
      { "name": "ohos.permission.DETECT_GESTURE" },
      { "name": "ohos.permission.ACCELEROMETER" },
      // 触觉反馈（计时到点 / 水平到位 / 罗盘对准）：系统权限，声明即生效、不弹授权框；
      // 设置页有开关（键 `haptic_feedback`），关掉后一次都不震。
      { "name": "ohos.permission.VIBRATE" },
      // 联网能力只在用户显式触发时使用：网络工具（DNS/端口/HTTP 响应头）、单位换算的汇率更新、
      // 设置页的节假日数据更新。GET_NETWORK_INFO 只用于域名解析（connection.getAddressesByName）。
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" }
    ],
    "metadata": [
      { "name": "ohos.arkui.UIMaterial.state", "value": "enable" },
      // 桌面长按图标的快捷方式直达工具（见 resources/base/profile/shortcuts_config.json）
      { "name": "ohos.ability.shortcuts", "resource": "$profile:shortcuts_config" }
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:toolbox_icon",
        "label": "$string:EntryAbility_label",
        // 启动页图标必须自带圆角：系统只对桌面图标做圆角遮罩，startWindowIcon 是原样居中显示的，
        // 直接用方角满幅的 toolbox_icon 会在启动页出现硬直角方图（模拟器实测）。
        "startWindowIcon": "$media:splash_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    // 桌面服务卡片（「常用工具」）的提供方；卡片页与显示规则见
    // resources/base/profile/form_config.json 与 ets/widget/pages/QuickToolsCard.ets。
    "extensionAbilities": [
      {
        "name": "QuickToolsFormAbility",
        "srcEntry": "./ets/widgetform/QuickToolsFormAbility.ets",
        "label": "$string:widget_quick_tools_label",
        "description": "$string:widget_quick_tools_desc",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      },
      // 分享接收：别的应用「分享」时在系统分享面板里提供「随身工具箱」，把文本交给二维码/文本工具。
      // 只接收**文本类**内容（图片与文件仍不接），页面为 pages/Share（见 main_pages.json），
      // 内容不落盘、不上传，处理完即收起会话（`shareext/ShareExtAbility.ets` 有完整口径）。
      {
        "name": "ShareExtAbility",
        "srcEntry": "./ets/shareext/ShareExtAbility.ets",
        "icon": "$media:toolbox_icon",
        "label": "$string:share_extension_label",
        "description": "$string:share_extension_desc",
        "type": "share",
        "exported": true,
        "skills": [
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            // 分享面板怎么匹配本扩展（2026-10-22 起排查、2026-10-23 收敛）：
            // ① **UTD 是主判据**——华为侧分享面板（`com.huawei.hmos.instantshare/SystemShareModalAbility`）与
            //    `@kit.ShareKit` 走 `SharedRecord.utd`（统一数据类型）。真机上 dump 微信的分享扩展，其 uris 形状是
            //    `{ "scheme": "file", "type": "", "utd": "general.text" }`；本应用原先 `utd` 全空 —— 只声明 MIME
            //    时面板里**一次都没出现**。
            // ② **`maxFileSupported` 必须写**：官方文档写明它**默认 0 = 不支持该类分享**，不写就等于声明了「不支持」。
            // ③ module.json5 的 schema 要求 `utd`/`maxFileSupported` 与 `scheme` 同时出现（`scheme` 在分享场景里
            //    是预留字段、不生效，写 `file` 只是合规写法）。
            // ④ **只声明父类型 `general.text` 一条**：2026-10-23 真机截图出现了**两个一模一样的「随身工具箱」**，
            //    原因是同时声明了 `general.plain-text` 与它的父类型 `general.text`，一条纯文本分享**同时命中两条**，
            //    面板就为同一个应用列了两行；官方口径是「支持全部子类型就声明父类型」。
            // ⑤ 仍然只收文本类：图片/视频/文件分享不出现本应用是设计如此（`ShareExtAbility` 只挑文本）。
            "uris": [
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
