/** 按 id 取固定文案；未知 id 原样返回 id（让拼错在界面上可见，而不是留白）。 */
export function appText(id: string, english: boolean): string {
  const entry: AppString | undefined = APP_STRINGS.find((item: AppString): boolean => item.id === id);
  if (entry === undefined) { return id; }
  return english ? entry.en : entry.zh;
}
