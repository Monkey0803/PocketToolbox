/**
 * 固定文案的登记表（2026-10-21 起，C 项「文案外置」的落地形态）。
 *
 * ## 为什么不是 `resources/<locale>/element/string.json` + `$r('app.string.x')`
 *
 * 资源解析跟随**系统/应用语言**，而本应用有**自己的语言偏好**（设置页「跟随系统 / 中文 / English」，
 * 存在 `language_preference`，由 `LanguagePreference` 求解成 `english: boolean`）。
 * 如果固定文案走 `$r`，用户把应用语言设成 English、系统仍是中文时，`$r` 取到的还是中文——
 * 与本应用的显式语言切换直接冲突（要修正得在切换时调 `System.setAppPreferredLanguage()`，
 * 那等于把「应用语言」这件事交给系统，且仍与满屏 `this.tr()` 混用两套机制）。
 *
 * 因此这里把**固定、不随输入变化**的文案集中成一张登记表，用 `appText(id, english)` 取；
 * `string.json` 只保留平台级字符串（应用名、扩展名/描述等由系统按资源读取的项）。
 *
 * ## 口径
 *
 * - **id 是唯一来源**：同一句话不要在页面里再写一份字面量；`appText()` 取不到的 id **原样返回 id**
 *   （界面会露出 `tab.tools` 这样的串），比返回空串更容易在验收时发现拼错。
 * - **只放固定文案**：带变量、拼接、随输入变化的文案仍走各页 `this.tr(zh, en)`；
 *   工具**页内**的字段标签与错误码文案也仍归各页（那些是页面语义的一部分）。
 * - **新增登记项**：在 `APP_STRINGS` 加一行（id 用 `域.名字`），并让单测的完整性断言覆盖
 *   （`id` 唯一、`zh`/`en` 非空、两者不相同——用来抓「忘了翻译」）。
 */

/** 一条固定文案：id + 中英两份文本。 */
export class AppString {
  readonly id: string;
  readonly zh: string;
  readonly en: string;

  constructor(id: string, zh: string, en: string) {
    this.id = id;
    this.zh = zh;
    this.en = en;
  }
}

